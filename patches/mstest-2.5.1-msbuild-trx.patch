+
+using Microsoft.Testing.Platform.Extensions;
+using Microsoft.Testing.Platform.Extensions.TestHostControllers;
+using Microsoft.Testing.Platform.Services;
+using Microsoft.Testing.Platform.TestHostControllers;
+
+using Moq;
+
+namespace Microsoft.Testing.Platform.UnitTests;
+
+[TestClass]
+public sealed class ControllerObserverTests
+{
+    [TestMethod]
+    public async Task ObserverDoesNotActivateAControllerOrConstructItsServices()
+    {
+        TestHostControllersManager manager = new();
+        manager.AddObserver(new CompositeExtensionFactory<Observer>(() => throw new InvalidOperationException("An in-process run must not construct the observer.")));
+
+        TestHostControllerConfiguration configuration = await manager.BuildAsync(new ServiceProvider());
+
+        Assert.IsFalse(configuration.RequireProcessRestart);
+        Assert.IsEmpty(configuration.LifetimeHandlers);
+        Assert.IsEmpty(configuration.EnvironmentVariableProviders);
+    }
+
+    [TestMethod]
+    public async Task RequiredControllerSharesTheObserverAcrossBothRoles()
+    {
+        TestHostControllersManager manager = new();
+        ITestHostProcessLifetimeHandler activator = Mock.Of<ITestHostProcessLifetimeHandler>(handler =>
+            handler.Uid == "activator" && handler.IsEnabledAsync() == Task.FromResult(true));
+        manager.AddProcessLifetimeHandler(_ => activator);
+        Observer observer = new();
+        manager.AddObserver(new CompositeExtensionFactory<Observer>(() => observer));
+
+        TestHostControllerConfiguration configuration = await manager.BuildAsync(new ServiceProvider());
+
+        Assert.IsTrue(configuration.RequireProcessRestart);
+        Assert.AreSequenceEqual([activator, observer], configuration.LifetimeHandlers);
+        Assert.AreSame(observer, Assert.ContainsSingle(configuration.EnvironmentVariableProviders));
+    }
+
+    [TestMethod]
+    public async Task DisabledObserverDoesNotJoinARequiredController()
+    {
+        TestHostControllersManager manager = new();
+        ITestHostProcessLifetimeHandler activator = Mock.Of<ITestHostProcessLifetimeHandler>(handler =>
+            handler.Uid == "activator" && handler.IsEnabledAsync() == Task.FromResult(true));
+        manager.AddProcessLifetimeHandler(_ => activator);
+        manager.AddObserver(new CompositeExtensionFactory<Observer>(() => new Observer(enabled: false)));
+
+        TestHostControllerConfiguration configuration = await manager.BuildAsync(new ServiceProvider());
+
+        Assert.IsTrue(configuration.RequireProcessRestart);
+        Assert.AreSame(activator, Assert.ContainsSingle(configuration.LifetimeHandlers));
+        Assert.IsEmpty(configuration.EnvironmentVariableProviders);
+    }
+
+    [TestMethod]
+    public void DuplicateObserverRegistrationIsRejected()
+    {
+        TestHostControllersManager manager = new();
+        CompositeExtensionFactory<Observer> factory = new(() => new Observer());
+        manager.AddObserver(factory);
+
+        Assert.ThrowsExactly<ArgumentException>(() => manager.AddObserver(factory));
+    }
+
+    private sealed class Observer(bool enabled = true) : ITestHostProcessLifetimeHandler, ITestHostEnvironmentVariableProvider
+    {
+        public string Uid => nameof(Observer);
+        public string Version => "1.0.0";
+        public string DisplayName => nameof(Observer);
+        public string Description => nameof(Observer);
+        public Task<bool> IsEnabledAsync() => Task.FromResult(enabled);
+        public Task BeforeTestHostProcessStartAsync(CancellationToken cancellationToken) => Task.CompletedTask;
+        public Task OnTestHostProcessStartedAsync(ITestHostProcessInformation testHostProcessInformation, CancellationToken cancellationToken) => Task.CompletedTask;
+        public Task OnTestHostProcessExitedAsync(ITestHostProcessInformation testHostProcessInformation, CancellationToken cancellationToken) => Task.CompletedTask;
+        public Task UpdateAsync(IEnvironmentVariables environmentVariables) => Task.CompletedTask;
+        public Task<ValidationResult> ValidateTestHostEnvironmentVariablesAsync(IReadOnlyEnvironmentVariables environmentVariables) => ValidationResult.ValidTask;
+    }
+}

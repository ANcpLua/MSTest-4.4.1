diff --git a/src/Platform/Microsoft.Testing.Extensions.MSBuild/MSBuildControllerLifetime.cs b/src/Platform/Microsoft.Testing.Extensions.MSBuild/MSBuildControllerLifetime.cs
new file mode 100644
index 0000000..29f4c66
--- /dev/null
+++ b/src/Platform/Microsoft.Testing.Extensions.MSBuild/MSBuildControllerLifetime.cs
@@ -0,0 +1,125 @@
+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT license. See LICENSE file in the project root for full license information.
+
+using Microsoft.Testing.Extensions.MSBuild.Serializers;
+using Microsoft.Testing.Platform.CommandLine;
+using Microsoft.Testing.Platform.Configurations;
+using Microsoft.Testing.Platform.Extensions;
+using Microsoft.Testing.Platform.Extensions.TestHostControllers;
+using Microsoft.Testing.Platform.Helpers;
+using Microsoft.Testing.Platform.IPC;
+using Microsoft.Testing.Platform.IPC.Models;
+using Microsoft.Testing.Platform.IPC.Serializers;
+using Microsoft.Testing.Platform.Logging;
+using Microsoft.Testing.Platform.TestHostControllers;
+
+namespace Microsoft.Testing.Extensions.MSBuild;
+
+// The controller owns the outer MSBuild connection. Its child uses an independently authorized
+// endpoint, so a sandboxed host never needs access to the full-trust build process's pipe.
+[UnsupportedOSPlatform("browser")]
+internal sealed class MSBuildControllerLifetime : MSBuildLifecycleCallbacksBase, ITestHostProcessLifetimeHandler, ITestHostEnvironmentVariableProvider, IDisposable
+{
+    internal const string PipeEnvironmentVariable = "TESTINGPLATFORM_MSBUILD_RELAY_PIPE";
+
+    private readonly IServiceProvider _serviceProvider;
+    private readonly IEnvironment _environment;
+    private readonly ILogger _logger;
+    private readonly ITask _task;
+    private readonly NamedPipeServerEndpoint _endpoint = NamedPipeServerFactory.CreateEndpoint();
+    private NamedPipeClient? _buildClient;
+    private NamedPipeServer? _hostServer;
+    private Task? _connection;
+    private CancellationToken _cancellationToken;
+
+    public MSBuildControllerLifetime(IServiceProvider serviceProvider, IConfiguration configuration, ICommandLineOptions commandLineOptions,
+        IEnvironment environment, ILoggerFactory loggerFactory, ITask task)
+        : base(configuration, commandLineOptions)
+    {
+        _serviceProvider = serviceProvider;
+        _environment = environment;
+        _logger = loggerFactory.CreateLogger<MSBuildControllerLifetime>();
+        _task = task;
+    }
+
+    public string Uid => nameof(MSBuildControllerLifetime);
+
+    public string DisplayName => nameof(MSBuildControllerLifetime);
+
+    public async Task BeforeTestHostProcessStartAsync(CancellationToken cancellationToken)
+    {
+        _cancellationToken = cancellationToken;
+        try
+        {
+            _buildClient = CreatePipeClient();
+            await _buildClient.ConnectAsync(cancellationToken).TimeoutAfterAsync(TimeoutHelper.DefaultHangTimeSpanTimeout, cancellationToken).ConfigureAwait(false);
+            _hostServer = NamedPipeServerFactory.CreateAndBind(_endpoint, ForwardAsync, _environment, _logger, _task, _serviceProvider, cancellationToken);
+            _hostServer.RegisterSerializer(new ModuleInfoRequestSerializer(), typeof(ModuleInfoRequest));
+            _hostServer.RegisterSerializer(new FailedTestInfoRequestSerializer(), typeof(FailedTestInfoRequest));
+            _hostServer.RegisterSerializer(new RunSummaryInfoRequestSerializer(), typeof(RunSummaryInfoRequest));
+            _hostServer.RegisterSerializer(new VoidResponseSerializer(), typeof(VoidResponse));
+            _connection = _hostServer.WaitConnectionAsync(cancellationToken);
+        }
+        catch (Exception failure)
+        {
+            try
+            {
+                Dispose();
+            }
+            catch (Exception cleanup)
+            {
+                throw new AggregateException(failure, cleanup);
+            }
+
+            throw;
+        }
+    }
+
+    public Task OnTestHostProcessStartedAsync(ITestHostProcessInformation testHostProcessInformation, CancellationToken cancellationToken)
+        => (_connection ?? throw new InvalidOperationException("The MSBuild controller relay was not started."))
+            .TimeoutAfterAsync(TimeoutHelper.DefaultHangTimeSpanTimeout, cancellationToken);
+
+    public Task OnTestHostProcessExitedAsync(ITestHostProcessInformation testHostProcessInformation, CancellationToken cancellationToken)
+        => Task.CompletedTask;
+
+    public Task UpdateAsync(IEnvironmentVariables environmentVariables)
+    {
+        environmentVariables.SetVariable(new EnvironmentVariable(PipeEnvironmentVariable, _endpoint.PipeName, isSecret: false, isLocked: true));
+        return Task.CompletedTask;
+    }
+
+    public Task<ValidationResult> ValidateTestHostEnvironmentVariablesAsync(IReadOnlyEnvironmentVariables environmentVariables)
+        => environmentVariables.TryGetVariable(PipeEnvironmentVariable, out OwnedEnvironmentVariable? value) && value.Value == _endpoint.PipeName
+            ? ValidationResult.ValidTask
+            : Task.FromResult(ValidationResult.Invalid("The MSBuild controller relay pipe was changed or removed."));
+
+    protected override void RegisterAdditionalSerializers(NamedPipeClient pipeClient)
+    {
+        pipeClient.RegisterSerializer(new FailedTestInfoRequestSerializer(), typeof(FailedTestInfoRequest));
+        pipeClient.RegisterSerializer(new RunSummaryInfoRequestSerializer(), typeof(RunSummaryInfoRequest));
+    }
+
+    private async Task<IResponse> ForwardAsync(IRequest request)
+    {
+        NamedPipeClient client = _buildClient ?? throw new InvalidOperationException("The MSBuild connection is not open.");
+        return request switch
+        {
+            ModuleInfoRequest module => await client.RequestReplyAsync<ModuleInfoRequest, VoidResponse>(module, _cancellationToken).ConfigureAwait(false),
+            FailedTestInfoRequest failure => await client.RequestReplyAsync<FailedTestInfoRequest, VoidResponse>(failure, _cancellationToken).ConfigureAwait(false),
+            RunSummaryInfoRequest summary => await client.RequestReplyAsync<RunSummaryInfoRequest, VoidResponse>(summary, _cancellationToken).ConfigureAwait(false),
+            _ => throw new NotSupportedException($"Unsupported MSBuild relay request: {request.GetType().FullName}"),
+        };
+    }
+
+    public void Dispose()
+    {
+        try
+        {
+            _hostServer?.Dispose();
+        }
+        finally
+        {
+            _buildClient?.Dispose();
+        }
+    }
+}

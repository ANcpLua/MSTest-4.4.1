<Project Sdk="MSTest.Sdk">

    <PropertyGroup>
        <RootNamespace>MSTest.Analyzers.ClassFixtures</RootNamespace>
        <!-- With two MSTest framework assemblies referenced, the analyzers find ParallelizeAttribute twice and
             MSTEST0001 reports the assembly although AssemblyPolicies.cs states its parallelization. -->
        <NoWarn>$(NoWarn);MSTEST0001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\MSTest.Analyzers 4.4.1\LegacyBase\LegacyBase.csproj"/>
        <ProjectReference Include="..\MSTest.Analyzers 4.4.1\CurrentBase\CurrentBase.csproj"/>
        <!-- The MSTest 3 framework assembly of LegacyBase, as a reference of the compilation under an alias. -->
        <PackageDownload Include="MSTest.TestFramework" Version="[3.11.1]"/>
        <Reference Include="$(NuGetPackageRoot)mstest.testframework/3.11.1/lib/net8.0/Microsoft.VisualStudio.TestPlatform.TestFramework.dll" Aliases="legacy"/>
    </ItemGroup>

</Project>

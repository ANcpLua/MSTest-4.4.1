<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

    <PropertyGroup>
        <RootNamespace>MSTest.Platform.Fixed.Browser</RootNamespace>
        <OutputType>Exe</OutputType>
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <!-- The IDE's desktop test-server launcher cannot host browser-wasm. -->
        <DisableTestingPlatformServerCapability>true</DisableTestingPlatformServerCapability>
        <!-- MSTest discovers these tests reflectively; keep their metadata in the published bundle. -->
        <PublishTrimmed>false</PublishTrimmed>
        <WasmBuildNative>false</WasmBuildNative>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MSTest.TestAdapter" Version="4.5.1"/>
        <PackageReference Include="MSTest.TestFramework" Version="4.5.1"/>
        <PackageReference Include="Microsoft.Testing.Extensions.AzureDevOpsReport" Version="2.5.1"/>
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1"/>
    </ItemGroup>

</Project>
